// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
  output        = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Opd {
  id        Int      @id @default(autoincrement())
  slug      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  namaOpd   String

  user User[]

  // Tambahkan ini agar OPD tahu jabatan apa saja yang dimilikinya
  jabatans Jabatan[]

  // Tambahkan ini jika Pegawai punya relasi langsung ke OPD
  pegawai         Pegawai[]
  mutasiAsal      Mutasi[]         @relation("opdAsal")
  mutasiTujuan    Mutasi[]         @relation("opdTujuan")
  proyeksiKeluars ProyeksiKeluar[]
}

model Jabatan {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  namaJabatan String
  level       Int    @default(1)

  // --- KOLOM LAMA JANGAN DIHAPUS ---
  kJ          Int   @default(0) // Kelas Jabatan tetap di sini!
  b           Int   @default(0) // BEZ
  aBK         Float @default(0.00) // ABK
  kurangLebih Int   @default(0)

  // --- TAMBAHAN HIRARKI ---
  parentId Int?
  parent   Jabatan?  @relation("JabatanHierarki", fields: [parentId], references: [id], onDelete: Cascade)
  children Jabatan[] @relation("JabatanHierarki")

  // --- RELASI OPD ---
  opdId Int? @default(1) // Tambahkan default sementara agar tidak error saat migrate
  opd   Opd? @relation(fields: [opdId], references: [id], onDelete: Cascade)

  pegawai        Pegawai[]
  tugas          Tugas[]
  proyeksiKeluar ProyeksiKeluar[]

  @@index([opdId])
  @@index([parentId])
}

model Pegawai {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  nama         String
  nip          String?   @unique // Tambahkan unique untuk keamanan data
  tanggalLahir DateTime?
  tempatLahir  String?

  pendidikanId Int?
  pendidikan   Pendidikan? @relation(fields: [pendidikanId], references: [id], onDelete: SetNull)

  jabatanId Int?
  jabatan   Jabatan? @relation(fields: [jabatanId], references: [id], onDelete: SetNull)

  // kedua kolom ini sudah tidak di gunakan. karena di pindahkan ke Tabel ProyeksiKeluar
  // statusKeluar String? // "mutasi", "dini", "meninggal"
  // tahunKeluar  Int? // Tahun rencana keluar (misal mutasi tahun 2027)

  // Relasi OPD biasanya cukup lewat Jabatan saja, 
  // tapi jika ingin tetap ada relasi langsung:
  opdId Int?
  opd   Opd? @relation(fields: [opdId], references: [id])

  mutasi         Mutasi[]
  proyeksiKeluar ProyeksiKeluar[]
}

model Tugas {
  id                        Int      @id @default(autoincrement())
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  namaTugas                 String?
  hasil                     String?
  jumlahBebanKerjaSetahun   Int      @default(0)
  waktuPenyelesaianDalamJam Int      @default(0)
  waktuEfektifPenyelesaian  Int      @default(0)
  KebutuhanPegawai          Float    @default(0.00)
  jabatanId                 Int
  jabatan                   Jabatan  @relation(fields: [jabatanId], references: [id])
}

model Pendidikan {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  namaPendidikan String
  pegawai        Pegawai[]
}

model Mutasi {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pegawaiId Int?
  pegawai   Pegawai? @relation(fields: [pegawaiId], references: [id])

  opdAsalId Int?
  opdAsal   Opd? @relation("opdAsal", fields: [opdAsalId], references: [id])

  opdTujuanId Int?
  opdTujuan   Opd? @relation("opdTujuan", fields: [opdTujuanId], references: [id])

  status  String? @default("pending") // approved, revisi, ditolak, pending
  alasan  String?
  catatan String?

  berkasMutasi BerkasMutasi[]
}

model BerkasMutasi {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status_berkas String? //valid, revisi, pending, rejected
  namaBerkas    String?
  urlBerkas     String?

  mutasiId Int?
  mutasi   Mutasi? @relation(fields: [mutasiId], references: [id], onDelete: Cascade)
}

model ProyeksiKeluar {
  id            Int       @id @default(autoincrement())
  pegawaiId     Int?
  pegawai       Pegawai?  @relation(fields: [pegawaiId], references: [id], onDelete: Cascade)
  jabatanId     Int? // Simpan ID Jabatan saat dia keluar
  jabatan       Jabatan?  @relation(fields: [jabatanId], references: [id], onDelete: Cascade)
  opdId         Int? // Simpan ID OPD asal
  opd           Opd?      @relation(fields: [opdId], references: [id], onDelete: Cascade)
  alasan        String? // "mutasi", "meninggal", "dini"
  tanggalKeluar DateTime? // Tanggal efektif dia berhenti menjabat
  tahun         Int? // Helper untuk query (2026, 2027, dsb)
}

model User {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clerkUserId String?  @unique // dari Clerk

  email     String?
  whatsapp  String?
  nama_user String?

  role String? // ADMIN_INDUK | ADMIN_OPD | PIMPINAN

  opdId Int?
  opd   Opd? @relation(fields: [opdId], references: [id])

  // --- RELASI CHAT ---
  pesanTerkirim     Pesan[]             @relation("PesanTerkirim")
  pesertaPercakapan PesertaPercakapan[]
}

// chat 
model RuangObrolan {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Nama instansi/OPD untuk memudahkan Admin Induk
  nama String?

  pesan   Pesan[]
  peserta PesertaPercakapan[]
}

model PesertaPercakapan {
  id       Int      @id @default(autoincrement())
  joinedAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  ruangObrolanId Int
  ruangObrolan   RuangObrolan @relation(fields: [ruangObrolanId], references: [id], onDelete: Cascade)

  @@unique([userId, ruangObrolanId])
}

model Pesan {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  isiPesan  String
  sudahBaca Boolean  @default(false)

  pengirimId Int
  pengirim   User @relation("PesanTerkirim", fields: [pengirimId], references: [id])

  ruangObrolanId Int
  ruangObrolan   RuangObrolan @relation(fields: [ruangObrolanId], references: [id], onDelete: Cascade)
}
